# 复制为 .env.local 后填写；.env.local 已被 .gitignore 排除，不会进仓库。
# Next.js 会自动加载 .env.local（dev 与 start 都生效）。

# ── 必填 ──────────────────────────────────────────────
# 凭据加密密钥（AES-256-GCM）。没有它，保存模型 API Key 会被拒绝（503 SECRET_NOT_CONFIGURED）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：换掉这个值后，之前用旧密钥加密保存的 API Key 将无法解密，需要重新填写。
CREDENTIAL_SECRET=

# 初始登录密码（至少 8 位）。
# 仅在 .data/db.json 首次生成时写入；若数据文件已存在，改这里不会改变密码。
# 需要重置：删除 .data/db.json 后重启，或用已登录身份调用 POST /api/v1/auth/password 修改。
AUTH_PASSWORD=demo-2026

# ── 选填 ──────────────────────────────────────────────
# 服务端兜底的模型密钥。仅当某个 Agent 自己没填 Key 时才用到；一般留空，让每个 Agent 各自配置。
ARK_API_KEY=

# 允许 Agent 连接私网 / 回环地址（默认 false，会拦截内网与云元数据地址以防 SSRF）。
# 只有确实要接局域网内的自建模型服务时才设为 true，开启会写审计日志。
ALLOW_PRIVATE_NETWORK=false
